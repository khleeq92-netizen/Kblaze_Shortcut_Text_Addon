# K-Flow Automation - optional build-time configuration.
# Copy to .env and fill in. All values can ALSO be entered at runtime in
# Dashboard -> Settings -> Cloud & Account, so this file is optional.

# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OAuth 2.0 Client ID (type "Web application") used for Google Sign-In and for
# reading/writing private Google Sheets through chrome.identity.launchWebAuthFlow.
# Redirect URIs: https://<extension-id>.chromiumapp.org/ and https://<extension-id>.chromiumapp.org/google
# Enable the "Google Sheets API" in the same Google Cloud project.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# AI provider API keys are NEVER configured here. Enter them in
# Dashboard -> Settings -> AI; they are encrypted on the device and never synced.

# Optional: public key (base64, no PEM headers) to pin a stable extension ID.
# Generate with: npm run generate-key
KF_EXTENSION_KEY=
