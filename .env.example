# QuickText Hub - optional build-time configuration.
# Copy to .env and fill in. All values can ALSO be entered at runtime in
# Dashboard -> Settings -> Cloud & Account, so this file is optional.

# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OAuth 2.0 Client ID (type "Web application") used for Google Sign-In through
# chrome.identity.launchWebAuthFlow. Redirect URI: https://<extension-id>.chromiumapp.org/
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional: public key (base64, no PEM headers) to pin a stable extension ID.
# Generate with: npm run generate-key
QTH_EXTENSION_KEY=
