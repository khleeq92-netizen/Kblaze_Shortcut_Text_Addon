  "workflows": [
    {
      "id": "wf_contact_form",
      "name": "Fill a contact form (demo)",
      "description": "Fills Name, Email and Message fields by their labels, then asks before submitting.",
      "enabled": true,
      "steps": [
        {
          "id": "w1",
          "type": "type",
          "target": {
            "kind": "label",
            "value": "Name"
          },
          "value": "{{me.name}}",
          "clear": true
        },
        {
          "id": "w2",
          "type": "type",
          "target": {
            "kind": "label",
            "value": "Email"
          },
          "value": "{{me.email}}",
          "clear": true
        },
        {
          "id": "w3",
          "type": "type",
          "target": {
            "kind": "label",
            "value": "Message"
          },
          "value": "Hello, I would like more information. Thanks!",
          "clear": true
        },
        {
          "id": "w4",
          "type": "click",
          "target": {
            "kind": "selector",
            "value": "button[type=submit], input[type=submit]"
          },
          "requireConfirm": true,
          "note": "Submit the form"
        }
      ],
      "createdAt": 1794775260747,
      "updatedAt": 1794775260747
    }
  ]
