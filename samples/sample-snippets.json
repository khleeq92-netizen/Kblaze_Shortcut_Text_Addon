    {
      "id": "snp_pay_reminder",
      "name": "Payment reminder",
      "shortcut": "/payment",
      "content": "Dear {{name}},\n\n{{toggle: overdue; label=Payment is already overdue?}}{{if: overdue}}This is a reminder that your payment of {{currency: amount; required; min=0}} for invoice {{text: invoice; label=Invoice #}} is now overdue. Kindly settle it by {{date: deadline; default=+3d}} to avoid any late fees.{{else}}Your payment of {{amount}} for invoice {{invoice}} is pending. Kindly complete it before {{deadline}}.{{endif}}\n\nIf you have already made the payment, please ignore this message.\n\nRegards,\n{{me.name}}\n{{me.company}}",
      "contentType": "text",
      "folderId": "fld_billing",
      "enabled": true,
      "favorite": true,
      "pinned": false,
      "description": "Polite reminder with amount and deadline; tone changes when overdue.",
      "tags": [],
      "trigger": "default",
      "source": {
        "kind": "template",
        "ref": "lib-pay-reminder"
      },
      "createdAt": 1794775260747,
      "updatedAt": 1794775260747
    },
    {
