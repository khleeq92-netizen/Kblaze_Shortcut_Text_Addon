{
  "name": "edudesk-correspondence-manager",
  "productName": "EduDesk Correspondence Manager",
  "version": "1.0.0",
  "description": "Offline correspondence, inward/outward register and document archive for schools and colleges.",
  "main": "src/main/main.js",
  "author": "EduDesk",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "node test/e2e/run-e2e.js",
    "dist:win": "electron-builder --win portable nsis --x64",
    "dist:win:dir": "electron-builder --win dir --x64",
    "build:assets": "node scripts/build-assets.js",
    "dist:mac": "electron-builder --mac dir --universal && codesign --force --deep --sign - \"dist/mac-universal/EduDesk Correspondence Manager.app\" && electron-builder --mac dmg zip --universal --prepackaged \"dist/mac-universal/EduDesk Correspondence Manager.app\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docxtemplater": "^3.71.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "regenerator-runtime": "^0.14.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.edudesk.correspondence",
    "productName": "EduDesk Correspondence Manager",
    "copyright": "EduDesk",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduDesk",
      "artifactName": "EduDesk-Setup-${version}.${ext}",
      "uninstallDisplayName": "EduDesk Correspondence Manager",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "EduDesk-Portable-${version}.${ext}"
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "EduDesk-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "EduDesk uses Microsoft Word to create the final PDF of your letters and to open letters for editing.",
        "NSDocumentsFolderUsageDescription": "EduDesk stores its registers and archived letters in Documents/EduDesk."
      }
    },
    "dmg": {
      "title": "EduDesk ${version}",
      "contents": [
        {
          "x": 130,
          "y": 200
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
